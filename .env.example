# ------------------------------------------------------------------
# TikTok Content Posting API (Direct Post)
# Register an app at https://developers.tiktok.com and enable the
# Content Posting API. Unaudited clients are restricted to PRIVATE
# posts until the app passes audit. See docs/RESEARCH.md.
# ------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=            # user-scoped access token (video.publish)
TIKTOK_OPEN_ID=                 # the authorizing user's open id
TIKTOK_REFRESH_TOKEN=           # used by refresh_access_token() when tokens expire
TIKTOK_PRIVACY=SELF_ONLY        # SELF_ONLY (private) while unaudited
TIKTOK_CHUNK_MB=50              # upload chunk size (TikTok: 5-64 MB)

# ------------------------------------------------------------------
# Ollama (local LLM)
# ------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b        # pull via:  ollama pull llama3.1:8b

# ------------------------------------------------------------------
# faster-whisper (local transcription)
# ------------------------------------------------------------------
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ------------------------------------------------------------------
# SMTP alerts (optional - send only if configured)
# ------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=TikTok Bot
SMTP_TO=

# ------------------------------------------------------------------
# Scheduling & maintenance
# ------------------------------------------------------------------
POSTS_PER_DAY=3
SCHEDULER_POLL_SECONDS=60
DAILY_REPORT_HOUR=8             # local hour for the daily email report
HEALTH_CHECK_INTERVAL_MINUTES=60

# ------------------------------------------------------------------
# Retry / backoff / safety limits
# ------------------------------------------------------------------
TIKTOK_MAX_ATTEMPTS=3
RETRY_BACKOFF_BASE_SECONDS=300  # 300s * 2^(attempt-1)
TIKTOK_PENDING_CAP=5            # TikTok: max ~5 pending API uploads per 24h

# ------------------------------------------------------------------
# Disk safety & retention
# ------------------------------------------------------------------
DISK_HIGH_WATER_MB=30000        # below this -> run cleanup
DISK_CRITICAL_MB=10000          # below this -> pause downloads + alert
ORIGINALS_KEEP_DAYS=7
CLIPS_KEEP_DAYS=30