# ------------------------------------------------------------------
# TikTok Content Bot - folder uploader
# Copy this file to .env and fill in your real values.
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# TikTok (required) — get these from https://developers.tiktok.com
# ------------------------------------------------------------------
# Developer portal credentials for your sandbox app:
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Minted by running:  python scripts/tiktok_auth.py
# (sandbox access tokens last ~24h; the bot auto-refreshes via the
#  refresh token, which lasts ~365 days and is re-saved to this file.)
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=

# Constant title used for EVERY post (required).
TIKTOK_TITLE=My Daily Post

# Privacy while the app is un-audited (must stay SELF_ONLY in sandbox —
# posts will be PRIVATE until TikTok approves your app for public posting).
TIKTOK_PRIVACY=SELF_ONLY

# Upload chunk size TikTok accepts: 5-64 MB.
TIKTOK_CHUNK_MB=50

# ------------------------------------------------------------------
# Scheduling (3 posts/day by default)
# Comma-separated local times the bot should try to post at.
# ------------------------------------------------------------------
UPLOAD_TIMES=04:00,12:00,20:00
PICK_ORDER=random        # random | oldest | newest | name
MOVE_UPLOADED=false      # move files to content/uploaded/ after a success
SIMULATE=false           # DRY RUN: pick+mark but DO NOT call TikTok

# How often the bot wakes up to check the clock / post a due video.
SCHEDULER_POLL_SECONDS=60
DAILY_REPORT_HOUR=20      # local hour (0-23) to email you the daily digest
HEALTH_CHECK_INTERVAL_MINUTES=60

# Retry behaviour for failed uploads: base * 2^(attempt-1) seconds.
TIKTOK_MAX_ATTEMPTS=3
RETRY_BACKOFF_BASE_SECONDS=600
TIKTOK_PENDING_CAP=5       # TikTok: <=5 pending API uploads per 24h

# ------------------------------------------------------------------
# Where your videos live (drop .mp4/.mov/.m4v/.mkv files here)
# ------------------------------------------------------------------
CONTENT_DIR=content

# ------------------------------------------------------------------
# SMTP alerts (required for the "all uploaded" and failure emails)
# ------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=TikTok Bot
SMTP_TO=
